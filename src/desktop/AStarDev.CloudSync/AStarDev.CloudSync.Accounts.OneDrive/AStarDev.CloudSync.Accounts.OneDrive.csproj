<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OneDrive accounts module: adds a personal Microsoft account through MSAL
    sign-in, the token cache and a Microsoft Graph drive lookup. The only
    project that references MSAL; with Sync.OneDrive, one of two that reference
    Microsoft.Graph. Must not reference Avalonia.
  -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
    <PackageReference Include="Microsoft.Graph" Version="6.8.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.90.1" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.90.1" />
    <PackageReference Include="Testably.Abstractions" Version="10.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AStarDev.CloudSync.Accounts/AStarDev.CloudSync.Accounts.csproj" />
    <ProjectReference Include="../AStarDev.CloudSync.Sync/AStarDev.CloudSync.Sync.csproj" />
    <ProjectReference Include="../../../../packages/AStarDev.LoggingExtensions/AStarDev.LoggingExtensions.csproj" />
  </ItemGroup>

</Project>
