<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SQLite sync module: its own DbContext and migration history for the sync
    tables (remote index, baseline, selection rules, attention queue, runs,
    activity) and per-account sync settings. Everything is internal except
    AddSyncPersistence. Must not reference Avalonia.
  -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Testably.Abstractions" Version="10.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AStarDev.CloudSync.Sync/AStarDev.CloudSync.Sync.csproj" />
    <ProjectReference Include="../../../../packages/AStarDev.DependencyInjection/AStarDev.DependencyInjection.csproj" />
    <ProjectReference Include="../../../../packages/AStarDev.LoggingExtensions/AStarDev.LoggingExtensions.csproj" />
    <ProjectReference Include="../../../../packages/AStarDev.EFCoreSqlite/AStarDev.EFCoreSqlite.csproj" />
  </ItemGroup>

</Project>
