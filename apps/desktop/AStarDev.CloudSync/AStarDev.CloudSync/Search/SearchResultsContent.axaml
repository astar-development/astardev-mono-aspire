<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:accounts="using:AStarDev.CloudSync.Accounts"
             xmlns:vmAccounts="using:AStarDev.CloudSync.ViewModels.Accounts"
             xmlns:vmSearch="using:AStarDev.CloudSync.ViewModels.Search"
             xmlns:vmSyncPairs="using:AStarDev.CloudSync.ViewModels.SyncPairs"
             x:Class="AStarDev.CloudSync.Search.SearchResultsContent"
             x:DataType="vmSearch:SearchResultsViewModel"
             VerticalContentAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             Foreground="{DynamicResource CloudSyncTextPrimaryBrush}">
    <UserControl.Styles>
        <Style Selector="Button.search-result">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.chip">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource CloudSyncBorderBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource CloudSyncTextMutedBrush}" />
        </Style>
        <Style Selector="Button.chip.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource CloudSyncAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource CloudSyncAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource CloudSyncTextPrimaryBrush}" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,*"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <TextBox Grid.Row="0"
                 Name="SearchPageBox"
                 Height="36"
                 Margin="0,0,0,12"
                 Text="{Binding SearchText}"
                 PlaceholderText="{Binding PlaceholderText}"
                 AutomationProperties.Name="{Binding PlaceholderText}" />

        <ItemsControl Grid.Row="1" Margin="0,0,0,12" ItemsSource="{Binding Files.Chips}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel ItemSpacing="6" LineSpacing="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vmSearch:FileFilterChipViewModel">
                    <Button Classes="chip" Classes.selected="{Binding IsSelected}" Content="{Binding Label}" Command="{Binding ToggleCommand}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ScrollViewer Grid.Row="2"
                      Name="SearchScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      MinHeight="0">
            <StackPanel Spacing="12">
                <TextBlock Classes="muted" Text="{Binding NoResultsText}" IsVisible="{Binding IsEmpty}" />

                <StackPanel Spacing="8" IsVisible="{Binding Accounts.Count}">
                    <TextBlock Classes="muted" Text="{Binding AccountsHeadingText}" FontSize="11" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmAccounts:AccountViewModel">
                                <Button Classes="search-result"
                                        Command="{Binding $parent[UserControl].((vmSearch:SearchResultsViewModel)DataContext).OpenAccountCommand}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Name}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <accounts:ProviderBadge Grid.Column="0" DataContext="{Binding Provider}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                            <TextBlock Classes="muted" Text="{Binding Email}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="8" IsVisible="{Binding Folders.Count}">
                    <TextBlock Classes="muted" Text="{Binding FoldersHeadingText}" FontSize="11" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmSyncPairs:SyncPairViewModel">
                                <Button Classes="search-result"
                                        Command="{Binding $parent[UserControl].((vmSearch:SearchResultsViewModel)DataContext).OpenFolderCommand}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Name}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <accounts:ProviderBadge Grid.Column="0" DataContext="{Binding Provider}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                            <TextBlock Classes="muted" Text="{Binding RemotePath}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="8" IsVisible="{Binding Files.IsActive}">
                    <TextBlock Classes="muted" Text="{Binding Files.HeadingText}" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Classes="muted" Text="{Binding Files.LoadingText}" IsVisible="{Binding Files.IsLoading}" />
                    <TextBlock Classes="muted" Text="{Binding Files.EmptyText}" IsVisible="{Binding Files.IsEmpty}" />
                    <TextBlock Text="{Binding Files.FailedText}"
                               IsVisible="{Binding Files.IsFailed}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource CloudSyncWarnBrush}" />
                    <TextBlock Text="{Binding Files.RevealErrorText}"
                               IsVisible="{Binding Files.HasRevealError}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource CloudSyncWarnBrush}" />
                    <ItemsControl ItemsSource="{Binding Files.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmSearch:FileRowViewModel">
                                <Button Classes="search-result"
                                        Command="{Binding RevealCommand}"
                                        AutomationProperties.Name="{Binding Name}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="muted" Text="{Binding CategoriesText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Classes="muted" Text="{Binding SizeText}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding Files.ShowMoreText}"
                            Command="{Binding Files.ShowMoreCommand}"
                            IsVisible="{Binding Files.HasMore}"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="{Binding Files.ShowMoreText}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
