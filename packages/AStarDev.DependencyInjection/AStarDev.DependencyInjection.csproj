<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AStarDev.DependencyInjection
    ════════════════════════════
    Helpers over Microsoft.Extensions.DependencyInjection. Kept apart from
    AStarDev.Utilities so that package stays free of package dependencies.
    Shared settings are inherited from packages/Directory.Build.props.
  -->

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageTags>dependency-injection;extensions;astar;astardevelopment</PackageTags>
    <Title>AStar Dev Dependency Injection</Title>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Description>Helpers over Microsoft.Extensions.DependencyInjection, such as creating the service a removed ServiceDescriptor describes.</Description>
    <PackageProjectUrl>https://github.com/astar-development/astar-dev-mono/tree/main/packages/core/utilities</PackageProjectUrl>
    <DocumentationFile>$(AssemblyName).xml</DocumentationFile>
    <PackageReleaseNotes>
        v0.1.0 refactor(di): move ServiceDescriptor.CreateInstance into AStarDev.DependencyInjection (#1900)
    </PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);CA1062</NoWarn>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
