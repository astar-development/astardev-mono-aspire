<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <RootNamespace>AStarDev.LoggingExtensions.TestsUnit</RootNamespace>
        <!-- Tests exercise the ILogger pipeline directly to verify log capture; CA1848 (LoggerMessage delegates) doesn't apply to test code. -->
        <NoWarn>$(NoWarn);CA1848;IDE1006;</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
        <PackageReference Include="coverlet.collector" Version="10.1.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageReference Include="Shouldly" Version="4.3.0" />
        <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.3" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.Extensions.Logging" />
        <Using Include="Xunit" />
        <Using Include="Shouldly" />
        <Using Include="JetBrains.Annotations" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../AStarDev.Utilities/AStarDev.Utilities.csproj" />
        <ProjectReference Include="..\AStarDev.LoggingExtensions\AStarDev.LoggingExtensions.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="ConfigurationTest.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.tests.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
